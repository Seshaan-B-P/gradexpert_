<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_chart_marker"
    android:elevation="6dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvMarkerSemTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Semester 3"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMarkerPrimaryMetric"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="SGPA: 8.85"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMarkerSecondaryMetric"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="CGPA: 8.60 • 86.0% • Distinction"
        android:textColor="#38BDF8"
        android:textSize="11sp" />

</LinearLayout>
